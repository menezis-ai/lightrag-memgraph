# sdist manifest — wheel uses [tool.setuptools.package-data] in pyproject.toml.
# Keep runtime WebUI/schema assets represented on both packaging paths.
recursive-include src/twindb_lightrag_memgraph/webui_dist *
recursive-include src/twindb_lightrag_memgraph/server/schemas *.json

# Strip dev-only artefacts that may sneak in via cp -R
recursive-exclude src/twindb_lightrag_memgraph/webui_dist mockServiceWorker.js
