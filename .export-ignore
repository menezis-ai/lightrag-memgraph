# Paths excluded from the delivery tarball built by
# `scripts/build_export.sh`. Format: one rsync-compatible pattern per
# line, blank lines and `#` comments ignored.
#
# Doctrine: the repo carries internal artifacts (audits, planning docs,
# Claude instructions) that have value in-tree but should NOT transit
# in the export. The export script is a one-way filter; the source
# repo is untouched.

# Claude Code instructions — internal contractual posture.
CLAUDE.md

# Live planning docs — internal cadence, status hedging, stakeholder
# context. Replace with the root README's public surface.
WEBUI-WIRING-PLAN.md
WEBUI-WIRING-WIRED.md
WEBUI-WIRING-TO-WIRE.md

# All internal docs — only the root README ships. docs/ carries
# audits, ops runbooks, pitch decks, templates that reference internal
# stakeholders, infra, and meeting context.
docs/

# Node build artifacts — rebuilt at the consumer's end.
**/node_modules/

# Local dev artifacts (also in .gitignore but belt-and-braces).
.coverage
coverage.xml
.pytest_cache/
.scannerwork/
.venv/
.vscode/
.menezis/
.DS_Store
build/
dist/
exports/
proto/
inputs/
rag_storage/
src/twindb_lightrag_memgraph.egg-info/
src/twindb_lightrag_memgraph/webui_dist/

# Git internals (always excluded from source archives anyway, but
# explicit so the script doesn't surprise anyone).
.git/
.github/
.forgejo/

# Export tooling shouldn't ship itself.
.export-ignore
scripts/build_export.sh
