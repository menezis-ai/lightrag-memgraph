# React port of the Twin RAG WebUI — production-build static deploy.
#
# Unlike the legacy JSX prototype (`Dockerfile` + `source/`), this image
# serves the Vite-built SPA from `lightrag_webui_twin/dist/`. MSW is
# baked in via VITE_FORCE_MSW=true at build time, so the SPA runs
# stand-alone — no FastAPI sibling reachable, no real backend.
#
# The build context is the repo root: this Dockerfile expects the
# pre-built `dist/` directory at /tmp/twin-react-deploy/ alongside the
# Caddyfile.react. See README.md (Update an existing deploy).

FROM caddy:2.8-alpine
COPY dist/ /srv/
COPY Caddyfile.react /etc/caddy/Caddyfile
EXPOSE 80 443
