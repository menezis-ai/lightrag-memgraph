# Caddyfile for the React port of the Twin RAG WebUI.
#
# Single-page app served with HTML5 history fallback. No /api/* proxy:
# MSW intercepts every fetch in the browser (VITE_FORCE_MSW=true baked
# into the build), so the SPA is fully self-contained.

{$SITE_ADDR::80} {
	root * /srv
	encode zstd gzip

	# SPA history-mode fallback: any non-asset path returns index.html
	# so client-side routes (e.g. /documents) survive a hard refresh.
	@spa {
		not path /assets/* /mockServiceWorker.js /favicon.svg /icons.svg
		not file
	}
	rewrite @spa /index.html

	file_server

	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# MSW is a service worker — needs a permissive scope and
		# no caching of the worker file itself so updates land.
		Service-Worker-Allowed "/"
		-Server
	}

	@worker path /mockServiceWorker.js
	header @worker Cache-Control "no-cache, no-store, must-revalidate"
}
