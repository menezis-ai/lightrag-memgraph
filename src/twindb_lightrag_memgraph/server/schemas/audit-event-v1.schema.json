{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twin-kms.invalid/schemas/audit-event-v1.schema.json",
  "title": "Twin KMS AuditEvent v1",
  "description": "ECS 9.4.0-aligned regulatory audit event projected from the Twin Activity ledger.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "@timestamp",
    "message",
    "ecs",
    "event",
    "service",
    "trace",
    "http",
    "user",
    "twin"
  ],
  "properties": {
    "@timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "ecs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version"],
      "properties": {
        "version": {"const": "9.4.0"}
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "category",
        "type",
        "action",
        "outcome",
        "severity",
        "provider",
        "module",
        "dataset"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 256},
        "kind": {"const": "event"},
        "category": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "api",
              "authentication",
              "configuration",
              "database",
              "file",
              "iam"
            ]
          }
        },
        "type": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "access",
              "admin",
              "change",
              "creation",
              "deletion",
              "denied",
              "end",
              "error",
              "info",
              "start"
            ]
          }
        },
        "action": {
          "enum": [
            "retrieval",
            "tag-mutation",
            "doc-retagged",
            "doc-approved",
            "doc-rejected",
            "doc-deleted",
            "doc-folder-added",
            "doc-folder-removed",
            "classification-rejected",
            "source-uploaded",
            "source-ready",
            "source-failed",
            "pipeline-warning",
            "graph-entity-edited",
            "graph-relation-edited",
            "auth",
            "settings",
            "api-key-created",
            "api-key-revoked",
            "vision-settings-updated",
            "procedure-parked",
            "procedure-failed",
            "procedure-approved",
            "procedure-rejected",
            "procedure-retried",
            "procedure-rerouted",
            "procedure-store-recovered",
            "linked-source-declared",
            "linked-source-updated",
            "linked-source-disabled",
            "kb-exported",
            "kb-imported"
          ]
        },
        "outcome": {"enum": ["failure", "success", "unknown"]},
        "severity": {"type": "integer", "minimum": 1, "maximum": 4},
        "provider": {"const": "twin-kms"},
        "module": {"const": "activity"},
        "dataset": {"const": "twin.audit"}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "environment"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 128},
        "version": {"type": "string", "minLength": 1, "maxLength": 64},
        "environment": {"type": "string", "minLength": 1, "maxLength": 64}
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "http": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request", "response"],
      "properties": {
        "request": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "method"],
          "properties": {
            "id": {"type": ["string", "null"], "maxLength": 128},
            "method": {
              "type": ["string", "null"],
              "pattern": "^[A-Z]+$",
              "maxLength": 16
            }
          }
        },
        "response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status_code"],
          "properties": {
            "status_code": {
              "type": ["integer", "null"],
              "minimum": 100,
              "maximum": 599
            }
          }
        }
      }
    },
    "user": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "roles"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 256},
        "roles": {
          "type": "array",
          "maxItems": 16,
          "items": {"type": "string", "maxLength": 128}
        }
      }
    },
    "twin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit", "auth", "resource", "folder", "workspace", "data"],
      "properties": {
        "audit": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "schema_version",
            "source",
            "source_event_kind",
            "severity_name",
            "operation",
            "emitted_by",
            "route_group"
          ],
          "properties": {
            "schema_version": {"const": "1.0.0"},
            "source": {"const": "activity"},
            "source_event_kind": {"$ref": "#/$defs/action"},
            "severity_name": {
              "enum": ["info", "warning", "error", "critical"]
            },
            "operation": {"type": ["string", "null"], "maxLength": 128},
            "emitted_by": {"type": ["string", "null"], "maxLength": 64},
            "route_group": {"type": ["string", "null"], "maxLength": 64}
          }
        },
        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method"],
          "properties": {
            "method": {
              "enum": [
                "idp",
                "local_jwt",
                "open",
                "operator_api_key",
                "static_api_key",
                "system",
                "unknown"
              ]
            }
          }
        },
        "resource": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id", "name"],
          "properties": {
            "type": {"type": "string", "minLength": 1, "maxLength": 128},
            "id": {"type": ["string", "null"], "maxLength": 512},
            "name": {"type": ["string", "null"], "maxLength": 512}
          }
        },
        "folder": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": ["string", "null"], "maxLength": 128}
          }
        },
        "workspace": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": ["string", "null"], "maxLength": 128}
          }
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": ["classification", "retention_policy"],
          "properties": {
            "classification": {"type": ["string", "null"], "maxLength": 128},
            "retention_policy": {"type": ["string", "null"], "maxLength": 128}
          }
        }
      }
    }
  },
  "$defs": {
    "action": {
      "enum": [
        "retrieval",
        "tag-mutation",
        "doc-retagged",
        "doc-approved",
        "doc-rejected",
        "doc-deleted",
        "doc-folder-added",
        "doc-folder-removed",
        "classification-rejected",
        "source-uploaded",
        "source-ready",
        "source-failed",
        "pipeline-warning",
        "graph-entity-edited",
        "graph-relation-edited",
        "auth",
        "settings",
        "api-key-created",
        "api-key-revoked",
        "vision-settings-updated",
        "procedure-parked",
        "procedure-failed",
        "procedure-approved",
        "procedure-rejected",
        "procedure-retried",
        "procedure-rerouted",
        "procedure-store-recovered",
        "linked-source-declared",
        "linked-source-updated",
        "linked-source-disabled",
        "kb-exported",
        "kb-imported"
      ]
    }
  }
}
