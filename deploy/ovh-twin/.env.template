# Template for the OVH twin-real deploy.
# Copy to ~/.twin-real.env on your workstation, fill in, chmod 600.
# DO NOT commit a filled instance.

# OpenAI key — used by LightRAG for chunking, entity extraction,
# embeddings, and query answering. Demo key, rotate after each demo.
OPENAI_API_KEY=

# Traefik Basic Auth — one htpasswd line (user:hash). Generate with:
#   htpasswd -nbB twin '<password>'
# Then DOUBLE every $ before writing it here (YAML/Compose escape).
TWIN_BASIC_AUTH=twin:$$2y$$05$$REPLACE_WITH_BCRYPT_HASH

# Image tag — bump on each deploy to force a service update.
IMAGE_TAG=2026-06-01a

# Twin workspace id (default: cib).
WORKSPACE=cib
